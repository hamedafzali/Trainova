{
  "version": "1",
  "description": "Canned model replies run through the real services and validators. Each case says whether the reply must be used or thrown away, and the ai_runs outcome it must produce.",
  "cases": [
    {
      "id": "analyst.grounded",
      "task": "analyst",
      "fixture": "squat_up_bench_flat",
      "reply": {
        "summary": "Your squat is climbing while your bench has stalled, and you're training 1 time per week against a target of 3.",
        "points": [
          { "title": "Squat is moving", "detail": "Estimated squat strength is up 15% this period.", "factIds": ["lift.0.change"] },
          { "title": "Bench is flat", "detail": "Bench has held at 93.5 kg across 4 sessions.", "factIds": ["lift.1.end", "lift.1.sessions"] },
          { "title": "Frequency is the lever", "detail": "You're at 33% of your weekly target.", "factIds": ["consistency.adherence"] }
        ]
      },
      "expect": { "accepted": true, "fallback": null, "outcome": "success" }
    },
    {
      "id": "analyst.invented-number",
      "task": "analyst",
      "fixture": "squat_up_bench_flat",
      "reply": {
        "summary": "Your squat is up 20% this month.",
        "points": [{ "title": "Squat", "detail": "Up 20%.", "factIds": ["lift.0.change"] }]
      },
      "expect": { "accepted": false, "fallback": "invalid", "outcome": "rejected", "errorCode": "INVALID", "mustNotContain": ["20%"] }
    },
    {
      "id": "analyst.projection",
      "task": "analyst",
      "fixture": "squat_up_bench_flat",
      "reply": {
        "summary": "At this rate you'll squat 150 kg by October.",
        "points": [{ "title": "Squat", "detail": "Keep adding weight.", "factIds": ["lift.0.change"] }]
      },
      "expect": { "accepted": false, "fallback": "invalid", "outcome": "rejected", "mustNotContain": ["150"] }
    },
    {
      "id": "analyst.unknown-fact",
      "task": "analyst",
      "fixture": "squat_up_bench_flat",
      "reply": {
        "summary": "Your squat is climbing.",
        "points": [{ "title": "Sleep", "detail": "Your sleep looks short.", "factIds": ["sleep.hours"] }]
      },
      "expect": { "accepted": false, "fallback": "invalid", "outcome": "rejected" }
    },
    {
      "id": "analyst.wrong-shape",
      "task": "analyst",
      "fixture": "squat_up_bench_flat",
      "reply": { "analysis": "Squat good, bench flat." },
      "expect": { "accepted": false, "fallback": "invalid", "outcome": "rejected" }
    },
    {
      "id": "analyst.unparseable",
      "task": "analyst",
      "fixture": "squat_up_bench_flat",
      "reply": "Sure! Here is your analysis: squat good.",
      "expect": { "accepted": false, "fallback": "unavailable", "outcome": "rejected", "errorCode": "BAD_OUTPUT" }
    },
    {
      "id": "analyst.harmful",
      "task": "analyst",
      "fixture": "squat_up_bench_flat",
      "reply": {
        "summary": "Your squat is up 15%.",
        "points": [{ "title": "Keep going", "detail": "Push through the pain in your knee to keep the gains coming.", "factIds": ["lift.0.change"] }]
      },
      "expect": { "accepted": false, "fallback": "invalid", "outcome": "rejected", "errorCode": "UNSAFE", "mustNotContain": ["Push through the pain"] }
    },
    {
      "id": "analyst.caution-is-fine",
      "task": "analyst",
      "fixture": "squat_up_bench_flat",
      "reply": {
        "summary": "Bench has stalled at 93.5 kg.",
        "points": [{ "title": "Bench stall", "detail": "If the stall comes with shoulder pain, don't train through pain; check with a clinician.", "factIds": ["lift.1.change"] }]
      },
      "expect": { "accepted": true, "fallback": null, "outcome": "success" }
    },
    {
      "id": "exercise_coach.grounded",
