    },
    {
      "id": "exercise_coach.invented-load",
      "task": "exercise_coach",
      "fixture": "leg_press_on_target",
      "reply": { "answer": "That looked easy. Go up to 110 kg.", "cues": [] },
      "expect": { "accepted": false, "fallback": "invalid", "outcome": "rejected", "mustNotContain": ["110"] }
    },
    {
      "id": "exercise_coach.near-max",
      "task": "exercise_coach",
      "fixture": "leg_press_near_max",
      "reply": { "answer": "That set was RPE 10, right at your limit. Drop to 95 kg so the next 8 reps stay clean.", "cues": ["Control the bottom"] },
      "expect": { "accepted": true, "fallback": null, "outcome": "success" }
    },
    {
      "id": "exercise_coach.red-flag",
      "task": "exercise_coach",
      "fixture": "leg_press_on_target",
      "question": "I get a sharp pain in my knee at the bottom, can I keep going?",
      "reply": { "answer": "Yes, keep going at 100 kg.", "cues": [] },
      "expect": { "accepted": false, "fallback": "red_flag", "outcome": null, "mustNotContain": ["keep going at 100 kg"] }
    },
    {
      "id": "trainer.chat.valid-swap",
      "task": "trainer.chat",
      "fixture": "starter",
      "message": "Bench hurts my wrists with the barbell. Can I swap it?",
      "reply": { "reply": "Let's swap barbell bench for dumbbell bench press, which lets your wrists rotate.", "actions": [{ "type": "swap_exercise", "workout": "W1", "slot": 2, "exerciseId": "e-dbbench" }] },
      "expect": { "accepted": true, "actions": 1, "notice": false, "outcome": "success" }
    },
    {
      "id": "trainer.chat.invalid-actions-dropped",
      "task": "trainer.chat",
      "fixture": "starter",
      "message": "Add some arm work.",
      "reply": { "reply": "I'll add curls.", "actions": [{ "type": "add_exercise", "workout": "W9", "exerciseId": "e-nothing", "sets": 3, "reps": 12 }] },
      "expect": { "accepted": true, "actions": 0, "notice": false, "outcome": "success", "validationIssues": 1 }
    },
    {
      "id": "trainer.chat.harmful",
      "task": "trainer.chat",
      "fixture": "starter",
      "message": "How do I break my squat plateau fast?",
      "reply": { "reply": "Run a short SARMs cycle to break the plateau.", "actions": [] },
      "expect": { "accepted": false, "actions": 0, "outcome": "rejected", "errorCode": "UNSAFE", "mustNotContain": ["SARM"] }
    },
    {
      "id": "trainer.chat.red-flag",
      "task": "trainer.chat",
      "fixture": "starter",
      "message": "I got chest pain during my last bench set. Should I add a set?",
      "reply": { "reply": "Stop and get that checked before you train again.", "actions": [{ "type": "set_volume", "workout": "W1", "slot": 2, "sets": 3, "reps": 8 }] },
      "expect": { "accepted": true, "actions": 0, "notice": true, "outcome": "success" }
    },
    {
      "id": "trainer.review.valid",
      "task": "trainer.review",
      "fixture": "starter",
      "reply": {
        "status": "getting_started",
        "headline": "A solid first week on Starter",
        "summary": "You've done your first Day A. Keep the squat moving and get the next session in this week.",
        "wins": ["First Day A done"],
        "focus": ["Log a second session this week"],
        "nextSession": { "workout": "W1", "hints": ["Repeat the squat at the same weight and aim for all 8 reps"] },
        "actions": []
      },
      "expect": { "accepted": true, "actions": 0, "outcome": "success" }
    },
    {
      "id": "trainer.review.missing-headline",
      "task": "trainer.review",
      "fixture": "starter",
      "reply": { "status": "on_track", "summary": "Good week." },
      "expect": { "accepted": false, "outcome": "rejected", "errorCode": "INVALID" }
    },
    {
      "id": "coach.intro.grounded",
      "task": "coach.intro",
      "fixture": "steady",
      "reply": { "intro": "You've been showing up, and it's paying off. Here's where things stand this week." },
      "expect": { "accepted": true, "outcome": "success" }
    },
    {
      "id": "coach.intro.number",
      "task": "coach.intro",
      "fixture": "steady",
      "reply": { "intro": "Great job hitting 4 workouts this week!" },
      "expect": { "accepted": false, "outcome": "rejected", "errorCode": "INVALID" }
    },
    {
      "id": "coach.meals.unsafe",
      "task": "coach.meals",
      "fixture": "cut",
      "reply": { "mealIdeas": [{ "meal": "Lunch", "idea": "Skip it and take laxatives to cut faster" }] },
      "expect": { "accepted": false, "outcome": "rejected", "errorCode": "UNSAFE", "mustNotContain": ["laxatives"] }
