# Backend variables (accounts + sync).
#
# In AdvancedContainerManager: set these in the project's *Variables* — ACM
# detects POSTGRES_PASSWORD and JWT_SECRET as required (from docker-compose.yml)
# and injects them when it runs compose. No .env file needed there.
#
# This file is only for running compose manually (copy to .env). Postgres is
# internal-only; nothing here is exposed publicly.

POSTGRES_PASSWORD=change-me-to-a-strong-random-string
JWT_SECRET=change-me-to-a-long-random-string

# "1" shows the login UI (baked at build time). Has a default of 1; optional.
NEXT_PUBLIC_AUTH_ENABLED=1

# Mistral AI API key for AI-powered features
# Get your API key from https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key-here

# Redis URL for caching (optional - will use localhost if not set)
# Format: redis://localhost:6379 or redis://user:password@host:port
REDIS_URL=redis://localhost:6379

# Sentry DSN for error monitoring (optional)
# Get your DSN from https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# Enable Sentry in development (set to 'true' to enable)
SENTRY_ENABLE_DEV=false
